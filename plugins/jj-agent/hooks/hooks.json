{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x /bin/bash ]; then /bin/bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"; else bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"; fi",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x /bin/bash ]; then /bin/bash \"${CLAUDE_PLUGIN_ROOT}/scripts/user-prompt.sh\"; else bash \"${CLAUDE_PLUGIN_ROOT}/scripts/user-prompt.sh\"; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x /bin/bash ]; then /bin/bash \"${CLAUDE_PLUGIN_ROOT}/scripts/pre-tool.sh\"; else bash \"${CLAUDE_PLUGIN_ROOT}/scripts/pre-tool.sh\"; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x /bin/bash ]; then /bin/bash \"${CLAUDE_PLUGIN_ROOT}/scripts/post-tool.sh\"; else bash \"${CLAUDE_PLUGIN_ROOT}/scripts/post-tool.sh\"; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x /bin/bash ]; then /bin/bash \"${CLAUDE_PLUGIN_ROOT}/scripts/post-tool.sh\"; else bash \"${CLAUDE_PLUGIN_ROOT}/scripts/post-tool.sh\"; fi",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
